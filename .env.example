# Path to your karaoke songs directory on the host machine
SONGS_PATH=/path/to/your/karaoke/songs

# Path to your music library directory on the host machine (MP3 / FLAC)
MUSIC_PATH=/path/to/your/music/library

# Optional: comma-separated top-level subfolder names (relative to MUSIC_PATH)
# to scope indexing to. If set, only these folders are scanned — everything
# else under MUSIC_PATH is ignored. Takes precedence over MUSIC_EXCLUDE_DIRS.
# MUSIC_INCLUDE_DIRS=PlexLooseless,PlexMusic

# Optional: comma-separated top-level subfolder names (relative to MUSIC_PATH)
# to skip. Ignored if MUSIC_INCLUDE_DIRS is set.
# MUSIC_EXCLUDE_DIRS=Karaoke,GuitarVideo

# Meilisearch master key — change this in production
MEILI_MASTER_KEY=karaoke-secret-key

# Login required to access the app — leave blank to disable auth
AUTH_USERNAME=
AUTH_PASSWORD=
